#!/bin/bash

yorn()
{
	while true; do
		read -p "$* [y/N]: " yn
		case $yn in
			[Yy]*) return 0;;
			[Nn]*) return 1;;
			*) return 1;;
		esac
	done
}

if grep -Eq "ID.*fedora" /etc/os-release; then
	echo "Unsupported OS, skipping"
fi

echo "Bootstrapping..."

if yorn "Install LazyVim"; then
	git clone https://github.com/LazyVim/starter $HOME/.config/nvim
	sudo curl -LO curl -LO https://github.com/neovim/neovim/releases/download/v0.11.5/nvim-linux-x86_64.appimage -o /usr/local/bin/nvim
	sudo chmod u+x /usr/local/bin/nvim
	sudo rm /usr/bin/vi
	sudo update-alternatives --install /usr/bin/vi vi /usr/local/bin/nvim 1
fi

if yorn "Installing packaged software"; then
	sudo dnf -y group install "C Development Tools and Libraries" "Development Tools"
	sudo dnf -y install $(cat $HOME/.config/yadm/dnflist)
fi

if yorn "Enable gdb dashboard?"; then
	wget -P ~ https://git.io/.gdbinit -O $HOME/.gdbinit
	pip install pygments
fi

echo "install finished"
